# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT:
# 1. Create a new project at https://app.supabase.com
# 2. Run the SQL migration in supabase/migrations/001_initial_schema.sql
# 3. Copy your Project URL and anon/public key here
# 4. Never commit the .env file with real keys to version control
