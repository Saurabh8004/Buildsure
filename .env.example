# ============================================
# BUILDSURE — ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your real Supabase credentials.
# 
# NEVER commit .env to GitHub — only .env.example should be committed.
#
# SETUP STEPS:
# 1. Go to https://app.supabase.com
# 2. Create a new project (or use existing one)
# 3. Go to Settings → API
# 4. Copy "Project URL" → paste as VITE_SUPABASE_URL
# 5. Copy your publishable key → paste as VITE_SUPABASE_ANON_KEY
#    - New format: starts with "sb_publishable_"
#    - Legacy format: starts with "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
# 6. Go to SQL Editor → run supabase/migrations/001_initial_schema.sql
# 7. Restart your dev server (npm run dev)
# 8. Visit /config-check to verify everything works
# ============================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
